# Supply-chain hardening: do not run arbitrary lifecycle scripts on install.
# Mitigates self-replicating npm worms (e.g. Shai-Hulud) that abuse postinstall.
# Native builds that genuinely need scripts (sharp, unrs-resolver) are
# allow-listed via pnpm.onlyBuiltDependencies in package.json.
ignore-scripts=true

# Fail installs that introduce known high-severity vulnerabilities.
audit-level=high

# Enforce engines field — refuse to install on unsupported Node/pnpm.
engine-strict=true
