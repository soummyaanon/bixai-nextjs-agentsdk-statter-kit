# Supply-chain hardening: do not run arbitrary lifecycle scripts on install.
# Mitigates self-replicating npm worms (e.g. Shai-Hulud) that abuse postinstall.
# If a specific dependency truly needs to build (e.g. sharp), allow-list it via
# pnpm's `onlyBuiltDependencies` in package.json or run `pnpm approve-builds`.
ignore-scripts=true

# Fail installs that introduce known high-severity vulnerabilities.
audit-level=high

# Enforce engines field — refuse to install on unsupported Node/pnpm.
engine-strict=true

# CI should additionally pass --frozen-lockfile to reject silent drift.
# (Not set here so local `pnpm install` can update the lockfile after edits.)
