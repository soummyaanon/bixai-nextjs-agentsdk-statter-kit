{
  "name": "@bixai/create-agent-sdk-starter",
  "version": "1.2.10",
  "description": "BixAI CLI to scaffold a Next.js + OpenAI Agents SDK starter app",
  "main": "dist/index.js",
  "bin": {
    "create-agent-sdk-starter": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/index.ts",
    "test": "echo \"No tests configured\""
  },
  "keywords": [
    "cli",
    "scaffold",
    "nextjs",
    "openai",
    "agents"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soummyaanon/bixai-nextjs-agentsdk-statter-kit.git"
  },
  "homepage": "https://create.bixai.dev",
  "bugs": {
    "url": "https://github.com/soummyaanon/bixai-nextjs-agentsdk-statter-kit/issues"
  },
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "dependencies": {
    "commander": "^14.0.3",
    "fs-extra": "^11.3.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
